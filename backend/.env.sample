# ─────────────────────────────────────────────────────────────────────────
# Edu-backend .env — every value below is validated on startup
# (see src/common/config/env.validation.ts). If a required value is
# missing or malformed, the server refuses to start and prints exactly
# which variable is wrong and why — check the terminal output first.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────
# PORT: optional, integer 1-65535. Defaults to 7001 if unset.
PORT=7001
# NODE_ENV: optional. Must be exactly "development", "production", or "test".
# Controls Swagger availability, HSTS, and whether ALLOWED_ORIGINS becomes required (see below).
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────
# DB_URL: REQUIRED. Must be a valid postgres:// or postgresql:// connection
# string (protocol + host + port + database name). Host does NOT need a
# real public domain — "localhost" (dev) or a Docker Compose service name
# like "db" (see docker-compose.yml) are both valid.
DB_URL=postgresql://user:password@localhost:5432/edu_db

# ── JWT / tokens ────────────────────────────────────────────────────────
# JWT_SECRET / ACCESS_TOKEN_KEY / REFRESH_TOKEN_KEY: all REQUIRED, minimum
# 32 characters each (256-bit minimum entropy for HMAC-SHA256 signing).
# Use three DIFFERENT random values, not the same secret three times —
# e.g. generate each with: openssl rand -hex 32
# Changing any of these logs out every currently-signed-in user.
JWT_SECRET=change_this_to_a_random_32_plus_character_secret
ACCESS_TOKEN_KEY=change_this_to_a_different_32_plus_char_secret
REFRESH_TOKEN_KEY=change_this_to_yet_another_32_plus_char_secret

# ACCESS_TOKEN_TIME / REFRESH_TOKEN_TIME: REQUIRED, integer seconds, each
# must be >= 60. REFRESH_TOKEN_TIME must be GREATER than ACCESS_TOKEN_TIME
# (a refresh token that expires before the access token it renews would
# break the frontend's silent token-refresh flow).
ACCESS_TOKEN_TIME=900
REFRESH_TOKEN_TIME=2592000

# ── Telegram Bot ────────────────────────────────────────────────────────
# BOT_TOKEN: REQUIRED. Must look like a real Telegram bot token:
# digits, a colon, then 30+ letters/digits/underscores/hyphens.
# OTP login AND every attendance/test/payment parent notification depend on this.
# Example shape only — get your real token from @BotFather on Telegram.
BOT_TOKEN=123456789:AAAA0000_example-token-placeholder-value

# ── Redis ───────────────────────────────────────────────────────────────
# REDIS_HOST / REDIS_PORT: both REQUIRED. OTP codes and session storage
# depend on Redis being reachable — this is mandatory in production.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Superadmin (auto-created on first boot if no SUPERADMIN user exists) ──
# SUPERADMIN_USERNAME: REQUIRED, minimum 3 characters.
# SUPERADMIN_PASSWORD: REQUIRED, minimum 8 characters — this becomes a real
#   login password, use something stronger than the example below.
# SUPERADMIN_PHONE: REQUIRED, digits only (9-15 digits, optional leading +).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=StrongPassword123!
SUPERADMIN_PHONE=+998901234567

# SUPERADMIN_EMAIL: optional, validated as an email format if provided.
# Note: not currently read anywhere in the codebase (the superadmin seed
# only uses USERNAME/PASSWORD/PHONE) — safe to leave unset.
SUPERADMIN_EMAIL=

# ── CORS ────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS: optional in development, REQUIRED when NODE_ENV=production
# (if empty in production, CORS blocks every single request from the frontend).
# Comma-separated list — each entry is individually validated as a full
# http(s):// URL (protocol required; "localhost" without a real domain is fine).
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ── AI test generation (optional feature) ──────────────────────────────
# GEMINI_API_KEY / GEMINI_MODEL: optional strings. Leave GEMINI_API_KEY
#   empty to keep AI test generation disabled regardless of the flag below.
# AI_TEST_GENERATION_ENABLED: optional, must be exactly "true" or "false".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TEST_GENERATION_ENABLED=false

# ── Avtomatik zaxira (scripts/backup-db.sh) — barchasi ixtiyoriy ────────
# Batafsil: scripts/README.md
# S3 (yoki S3-mos xizmat)ga yuklash uchun:
S3_BUCKET=
S3_ENDPOINT_URL=
# Yoki/qo'shimcha — boshqa serverga rsync orqali nusxalash uchun:
REMOTE_HOST=
REMOTE_DIR=
# Zaxira muvaffaqiyatsiz bo'lsa Telegram orqali xabar olish uchun
# (TELEGRAM_BOT_TOKEN berilmasa, yuqoridagi BOT_TOKEN avtomatik ishlatiladi):
TELEGRAM_CHAT_ID=
# Mahalliy zaxiralar necha kundan keyin avtomatik o'chirilsin (standart: 14)
RETENTION_DAYS=14
